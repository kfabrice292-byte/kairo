{
  "name": "kairo_backoffice",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "make": "npm run build && electron-builder",
    "lint": "eslint \"src/**/*.{ts,js}\" --fix"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase": "^12.16.0",
    "puppeteer": "^25.3.0",
    "vue": "^3.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vue/compiler-sfc": "^3.0.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "com.kairo.backoffice",
    "productName": "KAIRO Admin",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json",
      "node_modules/**/*"
    ]
  }
}
