rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // UTILS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Fonction qui va lire le profil pour vérifier si c'est un recruteur
    function isRecruiter() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter';
    }

    // ==========================================
    // USERS (Profils B2C et B2B)
    // ==========================================
    match /users/{userId} {
      // Un Talent peut lire son profil. Un Recruteur peut lire les profils des talents.
      allow read: if isAuthenticated();
      
      // Tout le monde peut créer son propre profil lors de l'inscription
      allow create: if isOwner(userId);
      
      // On peut mettre à jour uniquement son propre profil (en bloquant la modif du rôle)
      allow update: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      
      allow delete: if isOwner(userId);
    }

    // ==========================================
    // OPPORTUNITIES (Offres d'emploi)
    // ==========================================
    match /opportunities/{opportunityId} {
      // Lecture : Les talents sur l'app mobile doivent voir les offres, et les recruteurs aussi.
      allow read: if isAuthenticated();
      
      // Création : Seul un recruteur peut créer une offre, et il doit être défini comme "postedBy".
      allow create: if isRecruiter() && request.resource.data.postedBy == request.auth.uid;
      
      // Modification/Suppression : Seul le recruteur qui a posté l'offre peut la modifier.
      allow update, delete: if isAuthenticated() && resource.data.postedBy == request.auth.uid;
    }

    // ==========================================
    // APPLICATIONS (Candidatures pour l'ATS Kanban)
    // ==========================================
    match /applications/{applicationId} {
      // Création : Un Talent peut postuler, son ID doit être dans "candidateId"
      allow create: if isAuthenticated() && request.resource.data.candidateId == request.auth.uid;
      
      // Lecture :
      // 1. Le Talent peut lire SA candidature.
      // 2. Le Recruteur peut lire s'il est le créateur de l'offre concernée (Vérification croisée / get)
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        get(/databases/$(database)/documents/opportunities/$(resource.data.jobId)).data.postedBy == request.auth.uid
      );
      
      // Modification : Le Recruteur (propriétaire de l'offre) peut changer le statut (ATS Kanban)
      allow update: if isAuthenticated() && 
        get(/databases/$(database)/documents/opportunities/$(resource.data.jobId)).data.postedBy == request.auth.uid;
      
      // Suppression : Le Talent peut annuler sa candidature, ou le Recruteur peut la supprimer
      allow delete: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        get(/databases/$(database)/documents/opportunities/$(resource.data.jobId)).data.postedBy == request.auth.uid
      );
    }

    // ==========================================
    // FALLBACK
    // ==========================================
    // Bloque tout le reste par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
